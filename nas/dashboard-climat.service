# IMPORTANT : remplacez 'VOTRE_UUID' par l'UUID de votre disque/RAID (toutes les occurrences).
#
# Le dashboard tourne sous le compte système « ploufnas », sans les droits root : il lit
# config.json (groupe ploufnas) et n'écrit que dans le dossier reglages/. Le compte et les
# droits se créent à l'installation (README, « Dashboard sans root »).
[Unit]
Description=Dashboard Web ploufNAS
Wants=network-online.target
After=network-online.target
# Ne pas démarrer tant que le volume de stockage n'est pas monté
RequiresMountsFor=/srv/dev-disk-by-uuid-VOTRE_UUID/monitoring

[Service]
ExecStart=/usr/bin/python3 /srv/dev-disk-by-uuid-VOTRE_UUID/monitoring/dashboard.py
WorkingDirectory=/srv/dev-disk-by-uuid-VOTRE_UUID/monitoring
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
Restart=always
RestartSec=30
User=ploufnas
Group=ploufnas

# Durcissement : système en lecture seule, sauf le dossier des réglages
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/dev-disk-by-uuid-VOTRE_UUID/monitoring/reglages
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Port inférieur à 1024 (ex. 80) : remplacez « CapabilityBoundingSet= » par
# « CapabilityBoundingSet=CAP_NET_BIND_SERVICE » et décommentez AmbientCapabilities.
CapabilityBoundingSet=
#AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
